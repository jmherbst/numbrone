#!/usr/bin/env bash
# numbrone — a chief-of-staff workflow on top of herdr.
#
#   chief (you talk to it)  ──delegate──▶  mgr-<project>  ──spawn──▶  wk-<task>
#        ▲                                      │  ▲                      │
#        └────────────── report ────────────────┘  └──────── report ─────┘
#
# Everything is plain files in the numbrone home folder (the parent of this script's bin/):
#   projects.json          project index: { "<name>": { "path": ..., "summary": ... } }
#   projects/<name>/       context.md for each project
#   tasks/<task>.md        brief + status + append-only log, one file per task
#   roles/                 instructions for managers and workers
#   log/<date>.md          the daily work log: every task event, plus the chief's notes
#   (workers' git worktrees live in each project, under .numbrone/worktrees/)
#   numbrone.conf          which agent to run, and with which arguments
set -euo pipefail

NUMBRONE_HOME="${NUMBRONE_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
STATUSES="queued working blocked review done closed"

usage() {
  cat <<'EOF'
numbrone — chief-of-staff workflow on herdr

Setup
  numbrone init <dir>                            create (or upgrade) a numbrone home folder
  numbrone add <name> <path> "<summary>"         register a project
  numbrone remove <name>                         unregister a project
  numbrone projects                              list registered projects
  numbrone up [name]                             start a herdr workspace + manager for each project
  numbrone chief                                 mark the current agent as the chief, then show status

Work
  numbrone delegate <project> <task> "<brief>"   chief → manager: create a task and hand it over
                                                 (a manager can also use it to create its own tasks)
  numbrone spawn <task>                          manager → worker: worktree + tab + agent for a task
  numbrone report <task> <status> "<note>"       log progress and ping whoever is one level up
                                                 status: working | blocked | review | done
  numbrone status [task]                         overview of all open tasks, or one task's file
  numbrone close <task>                          close the worker tab, remove its worktree (keeps the branch)
  numbrone log ["<note>"]                        add a note to today's work log, or print it
EOF
}

# ── helpers ────────────────────────────────────────────────────────────────

die() { echo "numbrone: $*" >&2; exit 1; }
now() { date '+%Y-%m-%d %H:%M'; }

# Names become herdr agent names, which must match [a-z][a-z0-9_-]{0,31}.
check_name() { # <value> <max-length>
  [[ "$1" =~ ^[a-z][a-z0-9-]*$ && ${#1} -le $2 ]] ||
    die "'$1' must be lowercase letters, digits and dashes, start with a letter, max $2 chars"
}

load() {
  [ -f "$NUMBRONE_HOME/projects.json" ] || die "no numbrone home found at $NUMBRONE_HOME (run: numbrone init <dir>)"
  command -v jq >/dev/null || die "jq is required"
  AGENT_KIND=claude AGENT_ARGS="" BASE_REF="" PING_CHIEF=1
  # shellcheck source=/dev/null
  [ -f "$NUMBRONE_HOME/numbrone.conf" ] && . "$NUMBRONE_HOME/numbrone.conf"
  return 0
}

project_path() { jq -r --arg n "$1" '.[$n].path // empty' "$NUMBRONE_HOME/projects.json"; }
task_file()    { echo "$NUMBRONE_HOME/tasks/$1.md"; }
field()        { sed -n "s/^$2: //p" "$1" | head -n1; }                # <file> <key>
set_field()    { sed -i.bak "s|^$2:.*|$2: $3|" "$1" && rm -f "$1.bak"; } # <file> <key> <value>
log_line()     { echo "- $(now) [$2] $3" >> "$1"; journal "$2" "$(basename "$1" .md): $3"; } # <task file> <who> <text>

# The work log: one Markdown file per day in log/, appended to on every task event
# (and by `numbrone log`). Nothing is ever rewritten, so it doubles as an audit trail.
journal() { # <who> <text>
  local f; f="$NUMBRONE_HOME/log/$(date +%F).md"
  mkdir -p "$NUMBRONE_HOME/log"
  [ -f "$f" ] || printf '# Work log %s\n\n' "$(date +%F)" > "$f"
  echo "- $(date +%H:%M) [$1] $2" >> "$f"
}

workspace_id() { # herdr workspace labelled numbrone/<project>
  herdr workspace list |
    jq -r --arg l "numbrone/$1" '.result.workspaces[] | select(.label == $l) | .workspace_id' | head -n1
}
agent_state() { # prints idle|working|blocked|done|unknown, or "-" if no such agent
  herdr agent get "$1" 2>/dev/null | jq -r '.result.agent.agent_status' || echo "-"
}
my_name() { # the herdr agent name of whoever is calling numbrone
  [ -n "${HERDR_PANE_ID:-}" ] || { echo "shell"; return; }
  herdr agent list |
    jq -r --arg p "$HERDR_PANE_ID" '[.result.agents[] | select(.pane_id == $p) | .name // empty][0] // "shell"'
}

start_agent() { # <name> <pane> <first prompt>
  local args=()
  [ -n "$AGENT_ARGS" ] && read -r -a args <<< "$AGENT_ARGS"
  if ! herdr agent start "$1" --kind "$AGENT_KIND" --pane "$2" --timeout 120000 -- ${args[@]+"${args[@]}"} >/dev/null 2>&1; then
    [ "$(agent_state "$1")" = blocked ] || die "could not start $1 (see: herdr pane read $2)"
    # Usually a first-run question such as "Do you trust this folder?". Only a human should answer it.
    echo "numbrone: $1 is waiting at a startup prompt (e.g. 'trust this folder'). Answer it in herdr; waiting up to 5 min..." >&2
    herdr notification show "$1 needs you" --body "Answer its startup prompt in herdr" --sound request >/dev/null 2>&1 || true
    herdr agent wait "$1" --until idle --until done --timeout 300000 >/dev/null || die "$1 is still not ready"
  fi
  # Wait until the agent actually starts working. Right after startup a TUI can drop
  # the Enter key and leave the prompt unsent in its input box; one more Enter fixes it.
  herdr agent prompt "$1" "$3" --wait --until working --until blocked --timeout 30000 >/dev/null 2>&1 ||
    herdr agent send-keys "$1" enter >/dev/null
}

# ── setup ──────────────────────────────────────────────────────────────────

cmd_init() {
  [ $# -eq 1 ] || die "usage: numbrone init <dir>"
  local src dir
  src="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"   # the skill directory
  mkdir -p "$1"; dir="$(cd "$1" && pwd)"
  mkdir -p "$dir"/{bin,roles,tasks,projects,log}

  cp "$src/scripts/numbrone" "$dir/bin/numbrone" && chmod +x "$dir/bin/numbrone"
  # Everything below is yours to edit (retros improve it over time), so it is only
  # written the first time. Delete a file and re-run init to get a fresh copy.
  for f in roles/manager.md roles/worker.md CLAUDE.md; do
    [ -f "$dir/$f" ] || sed "s|{{NUMBRONE_HOME}}|$dir|g" "$src/templates/$(basename "$f")" > "$dir/$f"
  done
  [ -e "$dir/AGENTS.md" ]     || ln -s CLAUDE.md "$dir/AGENTS.md"
  [ -f "$dir/numbrone.conf" ] || cp "$src/templates/numbrone.conf" "$dir/numbrone.conf"
  [ -f "$dir/projects.json" ] || echo '{}' > "$dir/projects.json"
  echo "numbrone home ready at $dir"
}

cmd_add() {
  [ $# -eq 3 ] || die 'usage: numbrone add <name> <path> "<summary>"'
  load; check_name "$1" 28
  local root tmp
  root="$(git -C "$2" rev-parse --show-toplevel 2>/dev/null)" || die "$2 is not a git repository"
  tmp="$(mktemp)"
  jq --arg n "$1" --arg p "$root" --arg s "$3" '.[$n] = {path: $p, summary: $s}' \
    "$NUMBRONE_HOME/projects.json" > "$tmp" && mv "$tmp" "$NUMBRONE_HOME/projects.json"
  mkdir -p "$NUMBRONE_HOME/projects/$1"
  echo "added $1 → $root"
}

cmd_remove() {
  [ $# -eq 1 ] || die "usage: numbrone remove <name>"
  load
  local tmp; tmp="$(mktemp)"
  jq --arg n "$1" 'del(.[$n])' "$NUMBRONE_HOME/projects.json" > "$tmp" && mv "$tmp" "$NUMBRONE_HOME/projects.json"
  echo "removed $1 (its workspace and context files were left alone)"
}

cmd_projects() {
  load
  jq -r 'to_entries[] | "\(.key)\t\(.value.path)\t\(.value.summary)"' "$NUMBRONE_HOME/projects.json" |
    while IFS=$'\t' read -r name path summary; do
      printf '%-20s %-8s %s\n    %s\n' "$name" "$(agent_state "mgr-$name")" "$summary" "$path"
    done
}

cmd_up() {
  load
  local names name path ws pane
  names="${1:-$(jq -r 'keys[]' "$NUMBRONE_HOME/projects.json")}"
  for name in $names; do
    path="$(project_path "$name")"; [ -n "$path" ] || die "unknown project: $name"
    if [ "$(agent_state "mgr-$name")" != "-" ]; then echo "$name: manager already running"; continue; fi

    ws="$(workspace_id "$name")"
    if [ -z "$ws" ]; then
      pane="$(herdr workspace create --cwd "$path" --label "numbrone/$name" --no-focus | jq -r '.result.root_pane.pane_id')"
    else
      pane="$(herdr tab create --workspace "$ws" --cwd "$path" --label manager --no-focus | jq -r '.result.root_pane.pane_id')"
    fi
    start_agent "mgr-$name" "$pane" \
      "You are the manager for project '$name'. Read $NUMBRONE_HOME/roles/manager.md and $NUMBRONE_HOME/projects/$name/context.md, start any watches listed there, then reply 'ready'."
    echo "$name: started mgr-$name"
  done
}

cmd_chief() {
  [ -n "${HERDR_PANE_ID:-}" ] || die "run this from the chief's agent inside herdr"
  herdr agent rename "$HERDR_PANE_ID" chief >/dev/null
  echo "this agent is now 'chief'"
  cmd_status
}

# ── work ───────────────────────────────────────────────────────────────────

cmd_delegate() {
  [ $# -eq 3 ] || die 'usage: numbrone delegate <project> <task> "<brief>"'
  load; check_name "$2" 24
  local project="$1" task="$2" brief="$3" file
  [ -n "$(project_path "$project")" ] || die "unknown project: $project"
  file="$(task_file "$task")"
  [ -e "$file" ] && die "task '$task' already exists: $file"

  cat > "$file" <<EOF
# $task
project: $project
status: queued
branch:
worktree:
created: $(now)

## Brief
$brief

## Log
EOF
  log_line "$file" "$(my_name)" "queued"

  # A manager creating a task for itself (e.g. from a watched source) needs no message.
  if [ "$(my_name)" = "mgr-$project" ]; then echo "created $task; start it now (e.g. numbrone spawn $task)"; return; fi

  [ "$(agent_state "mgr-$project")" != "-" ] || cmd_up "$project"
  herdr agent prompt "mgr-$project" "New task '$task'. Brief: $file" >/dev/null ||
    die "task saved, but mgr-$project did not accept the message (blocked?). See: herdr agent read mgr-$project"
  echo "delegated $task → mgr-$project"
}

cmd_spawn() {
  [ $# -eq 1 ] || die "usage: numbrone spawn <task>"
  load
  local task="$1" file project path ws wt branch pane
  file="$(task_file "$task")"; [ -f "$file" ] || die "no such task: $task"
  project="$(field "$file" project)"; path="$(project_path "$project")"
  [ "$(agent_state "wk-$task")" = "-" ] || die "worker wk-$task is already running"

  # 1. A git worktree on its own branch, so workers never collide. It lives in
  #    <project>/.numbrone/worktrees/ (hidden via .git/info/exclude, never committed) so the
  #    agent inherits whatever folder trust the user already gave the project.
  wt="$path/.numbrone/worktrees/$task"; branch="numbrone/$task"
  if [ ! -d "$wt" ]; then
    local exclude; exclude="$(git -C "$path" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
    grep -qx '.numbrone/worktrees/' "$exclude" 2>/dev/null || { mkdir -p "$(dirname "$exclude")"; echo '.numbrone/worktrees/' >> "$exclude"; }
    if git -C "$path" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$path" worktree add -q "$wt" "$branch"
    else
      git -C "$path" worktree add -q -b "$branch" "$wt" ${BASE_REF:+"$BASE_REF"}
    fi
  fi

  # 2. A tab in the project's workspace, rooted in that worktree.
  ws="$(workspace_id "$project")"; [ -n "$ws" ] || die "no workspace for $project (run: numbrone up $project)"
  pane="$(herdr tab create --workspace "$ws" --cwd "$wt" --label "$task" --no-focus | jq -r '.result.root_pane.pane_id')"

  # 3. A worker agent that reads its brief. The task file is updated only once it started.
  if ! (start_agent "wk-$task" "$pane" \
      "You are worker wk-$task. Read $NUMBRONE_HOME/roles/worker.md, then your brief at $file, and start."); then
    herdr tab close "$(herdr pane get "$pane" | jq -r '.result.pane.tab_id')" >/dev/null 2>&1 || true
    exit 1
  fi
  set_field "$file" status working
  set_field "$file" branch "$branch"
  set_field "$file" worktree "$wt"
  log_line "$file" "$(my_name)" "spawned wk-$task on $branch"
  echo "spawned wk-$task in $wt"
}

cmd_report() {
  [ $# -eq 3 ] || die 'usage: numbrone report <task> <status> "<note>"'
  load
  local task="$1" status="$2" note="$3" file who up=""
  file="$(task_file "$task")"; [ -f "$file" ] || die "no such task: $task"
  [[ " $STATUSES " == *" $status "* ]] || die "status must be one of: $STATUSES"
  who="$(my_name)"

  set_field "$file" status "$status"
  log_line "$file" "$who" "$status: $note"

  # Ping one level up: worker → its manager, manager → chief.
  case "$who" in
    wk-*)  up="mgr-$(field "$file" project)" ;;
    mgr-*) [ "$PING_CHIEF" = 1 ] && up="chief" ;;
  esac
  if [ -n "$up" ] && [[ "$status" =~ ^(blocked|review|done)$ ]]; then
    herdr agent prompt "$up" "[numbrone] $task is $status ($who): $note" >/dev/null 2>&1 || true
  fi
  if [[ "$status" =~ ^(blocked|review|done)$ ]]; then
    herdr notification show "$task: $status" --body "$note" \
      --sound "$([ "$status" = blocked ] && echo request || echo done)" >/dev/null 2>&1 || true
  fi
  echo "reported $task: $status"
}

cmd_status() {
  load
  if [ $# -eq 1 ]; then cat "$(task_file "$1")"; return; fi

  local f task status last name
  printf '%-24s %-16s %-8s %-8s %s\n' TASK PROJECT STATUS WORKER "LAST UPDATE"
  for f in "$NUMBRONE_HOME"/tasks/*.md; do
    [ -e "$f" ] || continue
    task="$(basename "$f" .md)"; status="$(field "$f" status)"
    [ "$status" = closed ] && continue
    last="$(grep '^- ' "$f" | tail -n1 | cut -c3- | cut -c1-70)"
    printf '%-24s %-16s %-8s %-8s %s\n' "$task" "$(field "$f" project)" "$status" "$(agent_state "wk-$task")" "$last"
  done
  echo
  printf 'managers:'
  for name in $(jq -r 'keys[]' "$NUMBRONE_HOME/projects.json"); do
    printf ' mgr-%s=%s' "$name" "$(agent_state "mgr-$name")"
  done
  echo
}

cmd_close() {
  [ $# -eq 1 ] || die "usage: numbrone close <task>"
  load
  local task="$1" file project path wt tab
  file="$(task_file "$task")"; [ -f "$file" ] || die "no such task: $task"
  project="$(field "$file" project)"; path="$(project_path "$project")"; wt="$(field "$file" worktree)"

  # Refuse to throw away uncommitted work.
  if [ -n "$wt" ] && [ -d "$wt" ] && [ -n "$(git -C "$wt" status --porcelain)" ]; then
    die "$wt has uncommitted changes; commit or discard them first"
  fi
  tab="$(herdr agent get "wk-$task" 2>/dev/null | jq -r '.result.agent.tab_id')" || tab=""
  [ -n "$tab" ] && herdr tab close "$tab" >/dev/null
  [ -n "$wt" ] && [ -d "$wt" ] && git -C "$path" worktree remove "$wt"

  set_field "$file" status closed
  log_line "$file" "$(my_name)" "closed (branch $(field "$file" branch) kept)"
  echo "closed $task"
}

cmd_log() {
  load
  if [ $# -eq 0 ]; then cat "$NUMBRONE_HOME/log/$(date +%F).md" 2>/dev/null || echo "nothing logged today"
  else journal "$(my_name)" "$*"; fi
}

# ── dispatch ───────────────────────────────────────────────────────────────

cmd="${1:-help}"; shift || true
case "$cmd" in
  init|add|remove|projects|up|chief|delegate|spawn|report|status|close|log) "cmd_$cmd" "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
